# ── Build outputs ──────────────────────────────────────────
# Cargo build folders (cargo build / cargo run)
target/
debug/
release/

# Binaries & debug files from compiling directly with rustc
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.so
*.dylib
*.o
*.obj
*.d
*.rlib
*.rmeta
# `rustc main.rs` on Linux/macOS produces an extensionless `main`
**/main
!**/main/
!**/main.rs

# Generated progress site (built by scripts/build-site.mjs)
_site/

# ── Tooling ────────────────────────────────────────────────
# rustfmt backups
**/*.rs.bk

# cargo mutants
**/mutants.out*/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
rust_todo_list/todo.json
